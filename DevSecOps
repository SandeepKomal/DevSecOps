def COLOR_MAP = [
    'FAILURE' : 'danger',
    'SUCCESS' : 'good'
]

pipeline {
    agent any
    tools {
        jdk 'jdk17'
        maven 'maven3'
    }
    environment {
        SCANNER_HOME = tool 'sonar-scanner'
    }
    stages {

        // -------------------------------
        // 1. Checkout Code from Git
        // -------------------------------
        // Pulls the latest source code from the customer's Git repository.
        stage('Checkout From Git') {
            steps {
                git branch: 'master', url: 'https://github.com/<customer-org>/<customer-repo>.git'
            }
        }

        // -------------------------------
        // 2. Compile the code using Maven
        // -------------------------------
        stage('mvn compile') {
            steps {
                sh 'mvn clean compile'
            }
        }

        // -------------------------------
        // 3. Run Unit Tests
        // -------------------------------
        stage('mvn test') {
            steps {
                sh 'mvn test -DskipTests=true'
            }
        }

        // -------------------------------
        // 4. Security Scan with Lynis
        // -------------------------------
        stage('Lynis Security Scan') {
            steps {
                script {
                    sh 'lynis audit system | ansi2html > lynis-report.html'
                    def reportPath = "${WORKSPACE}/lynis-report.html"
                    echo "Lynis report generated: ${reportPath}"
                    archiveArtifacts artifacts: 'lynis-report.html'
                }
            }
        }

        // -------------------------------
        // 5. Dependency Vulnerability Scan
        // -------------------------------
        stage('OWASP FS SCAN') {
            steps {
                dependencyCheck additionalArguments: '--scan ./', odcInstallation: 'DC'
                dependencyCheckPublisher pattern: '**/dependency-check-report.xml'
            }
        }

        // -------------------------------
        // 6. Static Code Analysis
        // -------------------------------
        stage("Sonarqube Analysis") {
            steps {
                withSonarQubeEnv('sonar-server') {
                    sh ''' $SCANNER_HOME/bin/sonar-scanner -Dsonar.projectName=<CUSTOMER_PROJECT> \
                    -Dsonar.java.binaries=. \
                    -Dsonar.projectKey=<CUSTOMER_PROJECT_KEY> '''
                }
            }
        }

        // -------------------------------
        // 7. Build Maven Artifact
        // -------------------------------
        stage('Build') {
            steps {
                sh "mvn package -DskipTests=true"
            }
        }

        // -------------------------------
        // 8. Publish to Nexus Repository
        // -------------------------------
        stage('Publish To Nexus') {
            steps {
                withMaven(globalMavenSettingsConfig: 'global-maven', jdk: 'jdk17', maven: 'maven3', traceability: true) {
                    sh "mvn deploy -DskipTests=true"
                }
            }
        }

        // -------------------------------
        // 9. Build & Tag Docker Image
        // -------------------------------
        stage('Build & Tag Docker Image') {
            steps {
                script {
                    withDockerRegistry(credentialsId: 'docker-cred', toolName: 'Docker') {
                        sh "docker build -t <customer-registry>/<customer-app>:latest -f docker/Dockerfile ."
                    }
                }
            }
        }

        // -------------------------------
        // 10. Container Image Vulnerability Scan
        // -------------------------------
        stage('TRIVY') {
            steps {
                script {
                    sh 'trivy image --format table --timeout 5m -o trivy-image-report.html <customer-registry>/<customer-app>:latest'
                    def reportPath = "${WORKSPACE}/trivy-image-report.html"
                    echo "Trivy report generated: ${reportPath}"
                    archiveArtifacts artifacts: 'trivy-image-report.html'
                }
            }
        }

        // -------------------------------
        // 11. Push Docker Image to Registry
        // -------------------------------
        stage('Push Docker Image') {
            steps {
                script {
                    withDockerRegistry(credentialsId: 'docker-cred', toolName: 'Docker') {
                        sh "docker push <customer-registry>/<customer-app>:latest"
                    }
                }
            }
        }

        // -------------------------------
        // 12. Deploy to Kubernetes Cluster
        // -------------------------------
        stage('Deploy To Kubernetes') {
            steps {
                withKubeConfig(credentialsId: 'k8s-cred', namespace: '<customer-namespace>', serverUrl: '<customer-k8s-url>') {
                    sh "kubectl apply -f deploymentservice.yml"
                }
            }
        }

        // -------------------------------
        // 13. Verify Deployment in K8s
        // -------------------------------
        stage('Verify the Deployment') {
            steps {
                withKubeConfig(credentialsId: 'k8s-cred', namespace: '<customer-namespace>', serverUrl: '<customer-k8s-url>') {
                    sh "kubectl get pods -n <customer-namespace>"
                    sh "kubectl get svc -n <customer-namespace>"
                }
            }
        }

        // -------------------------------
        // 14. Runtime Web App Scan
        // -------------------------------
        stage('Nikto Security Scan') {
            steps {
                script {
                    sh 'nikto -h https://<customer-app-url> -o Nikto-report.html'
                    def reportPath = "${WORKSPACE}/Nikto-report.html"
                    echo "Nikto report generated: ${reportPath}"
                    archiveArtifacts artifacts: 'Nikto-report.html'
                }
            }
        }
    }

    // -------------------------------
    // Notifications after every build
    // -------------------------------
    post {
        always {
            echo 'Slack Notifications'
            slackSend(
                channel: '#jenkins',
                color: COLOR_MAP[currentBuild.currentResult],
                message: "${currentBuild.currentResult}: Job ${env.JOB_NAME} \n build ${env.BUILD_NUMBER} \n More info at: ${env.BUILD_URL}"
            )
        }
    }
}
